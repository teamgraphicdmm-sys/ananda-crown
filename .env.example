# SMTP Configuration for Direct Email Delivery (Zero Third-Party Services)
# Copy this file to .env.local or .env and fill in your credentials.

# SMTP Host (e.g. smtp.gmail.com or your custom mail server host)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# SMTP Secure (true for port 465, false for port 587)
SMTP_SECURE=true

# Sender / Auth Email
SMTP_USER=your-email@gmail.com

# Gmail 16-character App Password (or mailbox password)
SMTP_PASS=your-16-char-app-password

# Recipient Email for contact form submissions
CONTACT_TO_EMAIL=your-inbox@gmail.com
